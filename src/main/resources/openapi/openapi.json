    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z0-9_]{3,32}\\s*$",
            "description": "После удаления пробелов по краям: 3–32 латинские буквы, цифры или _. Регистр не учитывается.",
            "example": "student"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true,
            "example": "StrongPass123!"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "student"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "token",
          "expiresIn",
          "tokenType"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Подписанный HS256 JWT"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "default": 3600,
            "example": 3600
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "После trim: 1–200 символов. Пустое или состоящее из пробелов название отклоняется.",
            "example": "Подготовить КТ3"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": "",
            "example": "Проверить Swagger UI и запустить тесты"
          }
        }
      },
      "TaskResponse": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "completed",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Подготовить КТ3"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Проверить Swagger UI и запустить тесты"
          },
          "completed": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-23T10:00:00Z"
          }
        }
      },
      "TaskPage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "example": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          }
        }
      },
      "TaskStats": {
        "type": "object",
        "required": [
          "total",
          "active",
          "completed"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "validation_error"
          },
          "message": {
            "type": "string",
            "example": "id должен быть положительным целым числом"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "OpenApiDocument": {
        "type": "object",
        "description": "Документ OpenAPI 3.0.3",
        "additionalProperties": true
      }
    }
  }
}
